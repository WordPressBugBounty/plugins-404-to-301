{
    "name": "aioseo/404-to-301",
    "description": "Custom redirects (301, 302, 307), automatic 404 redirection, full 404 error logs and email alerts \u2014 a complete redirect & 404 toolkit.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://wordpress.org/plugins/404-to-301/",
    "authors": [
        {
            "name": "All in One SEO",
            "homepage": "https://aioseo.com/"
        }
    ],
    "support": {
        "issues": "https://github.com/awesomemotive/404-to-301/issues",
        "source": "https://github.com/awesomemotive/404-to-301",
        "forum": "https://wordpress.org/support/plugin/404-to-301/"
    },
    "require": {
        "php": ">=7.4",
        "vlucas/phpdotenv": "^5.6",
        "woocommerce/action-scheduler": "^3.9"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "AIOSEO\\FourNotFour\\": "app/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
